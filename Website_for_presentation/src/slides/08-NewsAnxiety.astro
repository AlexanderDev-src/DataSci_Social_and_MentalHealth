---
import Slide from "@features/deck/ui/Slide.astro";
import { AttentionCheck } from "@features/attention-check";
---

<Slide id="q3" question="คำถามวิจัยข้อ 3" title="ข่าวเชิงลบ กับความวิตกกังวล ทิศทางตรง แต่ยังยืนยันไม่ได้">
  <p>
    การติดตามข่าวเชิงลบสัมพันธ์กับความวิตกกังวลมากกว่ามิติอื่นตามที่คาด (r = 0.146)
    แต่ไม่มีนัยสำคัญ (p = 0.134) และคุมตัวแปรอื่นแล้วก็ยังไม่มี
  </p>
  <p>
    ผลนี้ข้ามเส้น 0.05 ได้เฉพาะเมื่อนับรวมผู้ตอบ 14 คนที่ตอบข้อดักผิด
    <span class="marker">ผลที่ขึ้นกับคนที่ไม่ได้อ่านคำถามจริง จึงไม่ใช้เป็นข้อสรุป</span>
  </p>

  <AttentionCheck slot="stage" client:visible />
</Slide>
